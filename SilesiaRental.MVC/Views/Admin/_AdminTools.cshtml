@model List<SilesiaRental.Models.Tool>

<div class="d-flex justify-content-between mb-3 fade-in">
    <h3 class="text-theme">All Tools (@Model.Count)</h3>
    <button class="btn btn-success rounded-pill px-4 shadow-sm">
        <i class="bi bi-plus-lg"></i> Add New
    </button>
</div>

<div class="table-responsive card-custom border-0">
    <table class="table table-hover align-middle mb-0 bg-transparent">
        <thead style="background: rgba(var(--primary-rgb), 0.05);">
            <tr>
                <th class="ps-4 text-theme border-glass">Tool</th>
                <th class="text-theme border-glass">Price / Day</th>
                <th class="text-theme border-glass">Status</th>
                <th class="text-end pe-4 text-theme border-glass">Actions</th>
            </tr>
        </thead>
        <tbody class="border-top-0">
            @foreach (var tool in Model) {
                <tr>
                    <td class="ps-4 border-glass">
                        <div class="d-flex align-items-center">
                            <div class="rounded d-flex align-items-center justify-content-center"
                                 style="width: 45px; height: 45px; overflow: hidden; background: rgba(128,128,128,0.1);">
                                <i class="bi bi-tools text-theme"></i>
                            </div>
                            <div class="ms-3">
                                <p class="fw-bold mb-0 text-theme">@tool.Name</p>
                                <small class="text-theme-muted">ID: @tool.ID</small>
                            </div>
                        </div>
                    </td>
                    <td class="text-theme fw-bold border-glass">@tool.PricePerDay zł</td>
                    <td class="border-glass">
                        @if (tool.IsAvailable) {
                            <span class="badge bg-success-subtle text-success border border-success px-3 rounded-pill">Available</span>
                        } else {
                            <span class="badge bg-secondary-subtle text-secondary border border-secondary px-3 rounded-pill">Rented</span>
                        }
                    </td>
                    <td class="text-end pe-4 border-glass">
                        <button class="btn btn-sm btn-outline-primary rounded-circle mx-1" title="Edit">
                            <i class="bi bi-pencil-square"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-danger rounded-circle mx-1" title="Delete">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.Count == 0) {
    <div class="text-center p-5 text-theme-muted fade-in">
        <i class="bi bi-box-seam display-4"></i>
        <p class="mt-3">No tools found inside database.</p>
    </div>
}