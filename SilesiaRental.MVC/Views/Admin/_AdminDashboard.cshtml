@{
    Layout = null;
}

<div class="container-fluid ps-0 fade-in">
    <div class="row g-0">
        <div class="col-md-3 col-lg-2 d-md-block sidebar collapse card-custom border-top-0 border-start-0 border-bottom-0 rounded-0" style="min-height: 80vh;">
            <div class="position-sticky pt-3">
                <h6 class="sidebar-heading d-flex justify-content-between align-items-center px-3 mt-4 mb-1 text-theme-muted text-uppercase">
                    <span>Admin Controls</span>
                </h6>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link admin-nav-link active fw-bold text-primary" href="#" onclick="loadAdminPart(this, '/Admin/ToolsList')">
                            <i class="bi bi-tools me-2"></i> Tools
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link admin-nav-link text-theme" href="#" onclick="loadAdminPart(this, '/Admin/UsersList')">
                            <i class="bi bi-people me-2"></i> Users
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link admin-nav-link text-theme" href="#" onclick="loadAdminPart(this, '/Admin/RentalsList')">
                            <i class="bi bi-receipt me-2"></i> Rentals
                        </a>
                    </li>
                </ul>

                <h6 class="sidebar-heading d-flex justify-content-between align-items-center px-3 mt-4 mb-1 text-theme-muted text-uppercase">
                    <span>System</span>
                </h6>
                <ul class="nav flex-column mb-2">
                    <li class="nav-item">
                        <a class="nav-link text-danger" href="/Account/Logout">
                            <i class="bi bi-box-arrow-right me-2"></i> Sign out
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom border-glass">
                <h1 class="h2 text-theme">Dashboard</h1>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <button type="button" class="btn btn-sm btn-outline-secondary text-theme border-glass">
                        <i class="bi bi-calendar"></i> This week
                    </button>
                </div>
            </div>

            <div id="admin-dynamic-content">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                </div>
            </div>
        </main>
    </div>
</div>