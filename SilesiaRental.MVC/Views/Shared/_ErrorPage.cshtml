@model string
@{
    Layout = null;
}

<div class="fade-in d-flex flex-column align-items-center justify-content-center pt-5">

    <div class="mb-4">
        <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 5rem; text-shadow: 0 4px 15px rgba(220, 53, 69, 0.4);"></i>
    </div>

    <h2 class="fw-bold mb-3" style="color: var(--text-color)">Something went wrong</h2>

    <div class="alert alert-danger border-0 shadow-sm d-inline-block px-4 py-3 mb-4"
         style="background: rgba(220, 53, 69, 0.1); color: #ea868f; max-width: 500px;">
        <i class="bi bi-bug-fill me-2"></i>
        <span>@(Model ?? "An unexpected error occurred. Please try again later.")</span>
    </div>

    <button class="btn btn-primary rounded-pill px-5 py-2 fw-bold shadow-sm"
            onclick="loadTab('rent', document.querySelector('.nav-link-custom'))">
        <i class="bi bi-arrow-counterclockwise me-2"></i> Try Again
    </button>

</div>