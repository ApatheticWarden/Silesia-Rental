@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>SilesiaRental</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        .fade-in {
            animation: fadeIn 0.3s ease-in-out;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>
<body>

    <nav class="navbar-glass">
        <div class="container-fluid px-4 position-relative d-flex align-items-center justify-content-between">
            <a class="navbar-brand d-flex align-items-center gap-2" href="#">
                <i class="bi bi-hammer"></i> <span>SilesiaRental</span>
            </a>

            <div class="position-absolute start-50 translate-middle-x d-none d-md-block">
                <div class="nav-pills-custom">
                    <a href="#" class="nav-link-custom active" data-tab="rent" onclick="loadTab('rent', this)">Rent Tool</a>
                    <a href="#" class="nav-link-custom" data-tab="return" onclick="loadTab('return', this)">Return Tool</a>
                    <a href="#" class="nav-link-custom" data-tab="bills" onclick="loadTab('bills', this)">My Bills</a>
                    @if (User.IsInRole("Admin")) {
                        <a href="#" class="nav-link-custom text-danger fw-bold" data-tab="admin" onclick="loadTab('admin', this)">
                            Admin Panel 🔒
                        </a>
                    }
                </div>
            </div>

            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-link nav-link-custom p-2" onclick="toggleTheme()"><i class="bi bi-moon-stars"></i></button>
                <div class="dropdown">
                    <a href="#" class="d-flex align-items-center gap-2 text-decoration-none" data-bs-toggle="dropdown">
                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 38px; height: 38px;">
                            @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                        </div>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow">
                        <li>
                            <a class="dropdown-item fw-bold" href="#" onclick="loadTab('profile', null)">Profile</a>
                            <a class="dropdown-item text-danger fw-bold" href="/Account/Logout">Logout</a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <div class="container mt-5">
        @if (TempData["Message"] != null) {
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm">
                <i class="bi bi-check-circle me-2"></i> @TempData["Message"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null) {
            <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm">
                <i class="bi bi-exclamation-triangle me-2"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div id="main-content">
            <div class="text-center mt-5"><div class="spinner-border text-primary"></div></div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // --- 1. ЛОГИКА СМЕНЫ ТЕМЫ ---
        function toggleTheme() {
            const htmlElement = document.documentElement;
            const currentTheme = htmlElement.getAttribute('data-bs-theme');
            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';

            htmlElement.setAttribute('data-bs-theme', newTheme);
            localStorage.setItem('silesia-theme', newTheme);
            updateThemeIcon(newTheme);
        }

        function updateThemeIcon(theme) {
            const icon = document.querySelector('.bi-moon-stars, .bi-sun');
            if (!icon) return;

            if (theme === 'dark') {
                icon.classList.remove('bi-moon-stars');
                icon.classList.add('bi-sun');
            } else {
                icon.classList.remove('bi-sun');
                icon.classList.add('bi-moon-stars');
            }
        }

        // --- 2. ЛОГИКА АДМИН-ПАНЕЛИ ---
        function loadAdminPart(element, url) {
            // Снимаем выделение со всех кнопок в админке
            document.querySelectorAll('.admin-nav-link').forEach(el => {
                el.classList.remove('active', 'text-primary', 'fw-bold');
                el.classList.add('text-theme');
            });

            // Подсвечиваем ту, на которую нажали
            if (element) {
                element.classList.remove('text-theme');
                element.classList.add('active', 'text-primary', 'fw-bold');
            }

            const container = document.getElementById('admin-dynamic-content');
            if (!container) return;

            container.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary"></div></div>';

            // Запрашиваем кусок админки (например, таблицу Tools)
            fetch(url)
                .then(res => {
                    if (!res.ok) throw new Error('Err: ' + res.status);
                    return res.text();
                })
                .then(html => {
                    container.innerHTML = html;
                })
                .catch(err => {
                    container.innerHTML = `<div class="alert alert-danger glass-alert">Error loading admin module: ${err.message}</div>`;
                });
        }

        // --- 3. ЛОГИКА ГЛАВНЫХ ВКЛАДОК ---
        function loadTab(tabName, element) {
            const container = document.getElementById('main-content');
            if (!container) return;

            if (element) {
                document.querySelectorAll('.nav-link-custom').forEach(el => el.classList.remove('active'));
                element.classList.add('active');
            }

            let url = '';
            if (tabName === 'rent')   url = '/Home/GetRentalsPartial';
            if (tabName === 'return') url = '/Home/GetReturnsPartial';
            if (tabName === 'bills')  url = '/Home/GetHistoryPartial';
            if (tabName === 'admin')  url = '/Admin/Dashboard';
            if (tabName === 'profile') url = '/Account/Profile';

            if (!url) return;

            container.innerHTML = '<div class="text-center mt-5"><div class="spinner-border text-primary"></div></div>';

            fetch(url)
                .then(res => {
                    if (res.status === 401) window.location.href = '/Account/Login';
                    if (!res.ok) throw new Error('Err: ' + res.status);
                    return res.text();
                })
                .then(html => {
                    container.innerHTML = html;

                    // ВАЖНО: Если мы только что загрузили интерфейс админки,
                    // сразу заставляем ее подгрузить список инструментов.
                    if (tabName === 'admin') {
                        const defaultAdminTab = document.querySelector('.admin-nav-link.active') || document.querySelector('.admin-nav-link');
                        if (defaultAdminTab) {
                            loadAdminPart(defaultAdminTab, '/Admin/ToolsList');
                        }
                    }
                })
                .catch(err => {
                    container.innerHTML = `<div class="alert alert-danger">Error: ${err.message}</div>`;
                });
        }

        // --- 4. ИНИЦИАЛИЗАЦИЯ ПРИ ЗАПУСКЕ ---
        document.addEventListener("DOMContentLoaded", function() {
            const savedTheme = localStorage.getItem('silesia-theme') || 'light';
            document.documentElement.setAttribute('data-bs-theme', savedTheme);
            updateThemeIcon(savedTheme);

            const activeBtn = document.querySelector('.nav-link-custom.active');
            if (activeBtn) {
                const tabName = activeBtn.getAttribute('data-tab') || 'rent';
                loadTab(tabName, activeBtn);
            } else {
                loadTab('rent', document.querySelector('.nav-link-custom'));
            }
        });
    </script>
</body>
</html>