@using SilesiaRental.Models
@model List<Tool>

<div class="row g-4 fade-in">
    @foreach (var tool in Model) {
        <div class="col-md-4 col-lg-3">
            <div class="card card-custom h-100 border-0">
                <div style="height: 180px; background: linear-gradient(135deg, rgba(37, 99, 235, 0.1) 0%, rgba(37, 99, 235, 0.05) 100%); display: flex; align-items: center; justify-content: center; font-size: 3rem; color: var(--primary);">
                    @tool.Name.Substring(0, 1)
                </div>
                <div class="card-body d-flex flex-column p-4 bg-transparent">
                    <h5 class="fw-bold text-theme">@tool.Name</h5>
                    <h6 class="fw-bold text-theme-muted mb-3" style="font-size: 0.9rem;">Description: @tool.Description</h6>

                    <div class="mt-auto pt-3 border-top border-glass d-flex justify-content-between align-items-center">
                        <span class="fs-5 fw-bold text-theme">@tool.PricePerDay zł/day</span>
                        <form method="post" action="/Home/Rent">
                            <input type="hidden" name="toolId" value="@tool.ID" />
                            <input type="hidden" name="version" value="@Convert.ToBase64String(tool.Version)" />

                            <button type="submit" class="btn btn-primary rounded-pill px-4 btn-sm shadow-sm">
                                Rent
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
    @if (Model.Count == 0) {
        <p class="text-center mt-5 text-theme-muted">
            The glass of water is always half-full!
        </p>
    }
</div>