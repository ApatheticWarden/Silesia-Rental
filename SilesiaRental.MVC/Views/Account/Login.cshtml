@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Login - SilesiaRental</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/css/site.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        /* Принудительный стиль для плейсхолдеров в темной теме */
        [data-theme="dark"] .form-control::placeholder {
            color: #aaa;
            opacity: 1;
        }

        [data-theme="dark"] .form-control {
            background-color: #374151;
            color: #fff;
            border-color: #4b5563;
        }

            [data-theme="dark"] .form-control:focus {
                background-color: #4b5563;
                color: #fff;
            }
    </style>
</head>
<body class="auth-wrapper">

    <div class="position-absolute top-0 end-0 p-4">
        <button class="btn btn-sm btn-outline-secondary rounded-circle" onclick="toggleTheme()">
            <i class="bi bi-moon-stars"></i>
        </button>
    </div>

    <div class="card card-custom p-5 shadow-lg" style="width: 400px;">
        <h2 class="text-center mb-4 fw-bold" style="color: var(--text-color)">Welcome Back</h2>

        @if (!string.IsNullOrEmpty(ViewBag.Error))
        {
            <div class="alert alert-danger text-center p-2 mb-4">
                <i class="bi bi-exclamation-triangle me-2"></i> @ViewBag.Error
            </div>
        }

        <form method="post" action="/Account/Login">
            <div class="mb-3">
                <label class="form-label small" style="color: var(--text-muted)">Username</label>
                <input type="text" name="username" class="form-control" required>
            </div>
            <div class="mb-4">
                <label class="form-label small" style="color: var(--text-muted)">Password</label>
                <input type="password" name="pass" class="form-control" required>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">Sign In</button>
        </form>

        <div class="text-center mt-4 pt-3 border-top" style="border-color: var(--glass-border) !important;">
            <p class="small mb-2" style="color: var(--text-muted)">No account yet?</p>
            <a href="/Account/Register" class="btn btn-outline-primary btn-sm w-100" action="/Account/Register">Create Account</a>
        </div>
    </div>

    <script>
        function toggleTheme() {
            const body = document.body;
            const current = body.getAttribute('data-theme');
            const newTheme = current === 'dark' ? 'light' : 'dark';
            body.setAttribute('data-theme', newTheme);
            localStorage.setItem('theme', newTheme);
        }
        if(localStorage.getItem('theme') === 'dark') document.body.setAttribute('data-theme', 'dark');
    </script>
</body>
</html>