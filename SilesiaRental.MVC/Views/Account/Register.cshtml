@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - SilesiaRental</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

    <style>
        /* === ОСНОВНОЙ ФОН === */
        body {
            background-color: #1a1d20;
            color: #e0e0e0;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .card {
            background-color: #212529;
            border: 1px solid #373b3e;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.5);
            width: 100%;
            max-width: 400px;
        }

        h2, h3, h4, h5, h6 {
            color: #ffffff;
        }

        .text-muted {
            color: #adb5bd !important;
        }

        a {
            color: #6ea8fe;
        }

        /* === ПОЛЯ ВВОДА === */
        .form-control {
            background-color: #2c3034;
            border-color: #495057;
            color: #fff !important;
        }

            .form-control:focus {
                background-color: #2c3034;
                border-color: #0d6efd;
                color: #fff;
                box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
            }

            .form-control::placeholder {
                color: transparent !important; /* Скрываем плейсхолдер, чтобы работал эффект плавания */
            }

        /* === FLOATING LABELS + ICON === */
        /* Тут магия: мы настраиваем лейбл так, чтобы иконка и текст смотрелись слитно */
        .form-floating > label {
            color: #adb5bd;
            padding-left: 1rem; /* Обычный отступ */
        }

        /* Когда поле в фокусе или заполнено */
        .form-floating > .form-control:focus ~ label,
        .form-floating > .form-control:not(:placeholder-shown) ~ label {
            color: #adb5bd;
            opacity: 0.8;
            /* Bootstrap сам сделает transform: scale(0.85) - иконка тоже уменьшится */
        }

        /* Убираем конфликты фона */
        .form-floating > .form-control:-webkit-autofill {
            -webkit-box-shadow: 0 0 0 30px #2c3034 inset !important;
            -webkit-text-fill-color: white !important;
        }

        /* Кнопка */
        .btn-brand {
            background-color: #0d6efd;
            border: none;
            padding: 10px;
            font-weight: 600;
        }

            .btn-brand:hover {
                background-color: #0b5ed7;
            }

        .logo-icon {
            font-size: 2.5rem;
            color: #0d6efd;
        }
    </style>
</head>
<body>

    <div class="container d-flex justify-content-center">
        <div class="card p-4 rounded-4">
            <div class="card-body">
                <div class="text-center mb-4">
                    <i class="bi bi-hammer logo-icon"></i>
                    <h2 class="fw-bold mt-2">SilesiaRental</h2>
                    <p class="text-muted">Create your account</p>
                </div>

                <form method="post" action="/Account/RegisterUser">

                    <div class="form-floating mb-3">
                        <input type="text" class="form-control" id="username" name="Username" placeholder="Login" required>
                        <label for="username">
                            <i class="bi bi-person me-2"></i>Username
                        </label>
                    </div>

                    <div class="form-floating mb-3">
                        <input type="password" class="form-control" id="password" name="Password" placeholder="Password" required minlength="6">
                        <label for="password">
                            <i class="bi bi-lock me-2"></i>Password
                        </label>
                    </div>

                    <div class="form-floating mb-4">
                        <input type="password" class="form-control" id="confpassword" name="ConfirmPassword" placeholder="Confirm password" required>
                        <label for="confpassword">
                            <i class="bi bi-shield-lock me-2"></i>Confirm Password
                        </label>
                    </div>

                    <button type="submit" class="btn btn-primary btn-brand w-100 rounded-pill mb-3">
                        Register
                    </button>

                    <div class="text-center">
                        <small class="text-muted">
                            Already have an account?
                            <a href="/Account/Login" class="text-decoration-none fw-bold">Sign In</a>
                        </small>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        const form = document.querySelector('form');
        const p1 = document.getElementById('password');
        const p2 = document.getElementById('confpassword');

        form.addEventListener('submit', function (e) {
            if (p1.value !== p2.value) {
                e.preventDefault();
                alert("Passwords do not match!");
                p2.classList.add('is-invalid');
            }
        });

        p2.addEventListener('input', () => p2.classList.remove('is-invalid'));
    </script>

</body>
</html>